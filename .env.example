# ==============================================================================
# Environment variables
# ==============================================================================
# Template for LOCAL development: copy to `.env` and adjust. `manage.py` loads
# `.env` automatically under local settings.
#
# The LOCAL section is all you need to run the app locally. The DEPLOYED section
# documents every variable read by the deployed settings (`config.settings.prod`
# and `config.settings.dev`); set those on Railway (per service), not in this file.
# Deployed hosts, CORS/CSRF origins, DB pool sizes, cookie policy, and the email
# sender domain are hardcoded in dev.py/prod.py -- only the secrets below remain
# environment-driven.
# ==============================================================================

# ------------------------------------------------------------------------------
# Local development (config.settings.local)
# ------------------------------------------------------------------------------
# DATABASE_URL=sqlite:///dev.db
# REDIS_URL=redis://localhost:6379/0

# Optional local overrides (defaults shown):
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<insecure dev default is used if unset; override to set your own>
# CELERY_TASK_ALWAYS_EAGER=True    # run tasks inline; set False to use a real worker
# DJANGO_SETTINGS_MODULE=config.settings.local   # set by manage.py
# DJANGO_READ_DOT_ENV_FILE=True                  # set by manage.py; enables reading this file

# ------------------------------------------------------------------------------
# Deployed / Railway -- set on Railway, not here
# ------------------------------------------------------------------------------
# Use config.settings.prod for the production environment and config.settings.dev
# for the dev environment. Hosts, CORS/CSRF origins, cookie policy, DB pool sizes,
# and the Mailgun sender domain / from-address are hardcoded in those files -- edit
# them there, not via env vars. Only the secrets below stay environment-driven.
#
# Required:
# DJANGO_SETTINGS_MODULE=config.settings.prod   # or config.settings.dev on the dev environment
# SECRET_KEY=<generate: python -c "import secrets; print(secrets.token_urlsafe(64))">
# DATABASE_URL=<reference Railway Postgres, e.g. ${{Postgres.DATABASE_URL}}>
# REDIS_URL=<reference Railway Redis, e.g. ${{Redis.REDIS_URL}}>

# Optional secrets (enable a feature when set):
# SENTRY_DSN=               # enables Sentry when set
# MAILGUN_API_KEY=          # enables Anymail/Mailgun when set
# SENTRY_RELEASE=           # defaults to RAILWAY_GIT_COMMIT_SHA

# Provided automatically by Railway (do not set manually):
# PORT                         # web port gunicorn binds to
# RAILWAY_GIT_COMMIT_SHA       # default Sentry release

# Deploy tuning (optional; set on the relevant Railway service; defaults shown):
# WEB_CONCURRENCY=2            # gunicorn worker processes (web service)
# WEB_WORKER_CONNECTIONS=100   # greenlets per web worker (web service)
# CELERY_WORKER_CONCURRENCY=100  # celery greenlets (worker service)
